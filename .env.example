ANTHROPIC_API_KEY=sk-ant-your-key-here
AGENT_MODEL=claude-sonnet-5-5

# Max reasoning/tool steps before the agent is stopped
MAX_STEPS=12
# Total input+output tokens allowed per run
TOKEN_BUDGET=60000
# Same tool with the same arguments more than this = treated as a loop
MAX_REPEAT_CALLS=2
# How many times self-reflection may send the report back for revision
MAX_REVISIONS=1